{
  "disableVanillaPortals": {
    // Disables vanilla portals, 
    // Default:false
    "disableVanillaPortals": false
  },

  "teleportCooldown": {
    // Sets a delay before you can teleport again, 
    // Default:15 seconds
    "teleportCooldown": 15
  },

  "instantTeleport": {
    // Instantly teleports instead of notifying the user over time,(Note this causes some lag, due to loading chunks directly) 
    // Default:false
    "instantTeleport": false
  },

  "teleportedRidden": {
    // Teleport ridden entities too, 
    // Default:true
    "teleportedRidden": true
  },

  "teleportLeashed": {
    // Teleport leashed entities too, 
    // Default:true
    "teleportLeashed": true
  },

  "debuglogging": {
    // Enable debug logging, 
    // Default:false
    "debuglogging": false
  },

  "dimensionconnections": [
